# See PROJECT_BRIEF.md §16. Server-side secrets must never be committed or shipped to the frontend.
APP_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Panta (server only — NEVER expose to the browser)
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=pk_live_replace_me
PANTA_MOCK=true

# Solana
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=replace_me
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=replace_me
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Fees / limits
FEE_WALLET_PUBKEY=replace_me
APP_FEE_BPS=75
MAX_BASKET_LEGS=4
DEFAULT_SLIPPAGE_BPS=150

# Auth / security
JWT_SECRET=replace_me_with_random_32_bytes
ADMIN_WALLETS=pubkey1,pubkey2
BLOCKED_COUNTRIES=US
CORS_ORIGINS=http://localhost:5173

# Server bind
API_BIND=0.0.0.0:8080

# Frontend (apps/web/.env)
VITE_API_BASE_URL=http://localhost:8080
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
