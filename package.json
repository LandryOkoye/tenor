{
  "name": "app-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "typegen": "cargo test -p domain export_bindings",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cargo watch -x 'run -p api'",
    "dev:worker": "cargo watch -x 'run -p worker'",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && cargo test --workspace"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
